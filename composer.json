{
    "name": "kyrch/laravel-prohibitions",
    "description": "Prohibit your models from execute an action in a way similar to spatie/laravel-permission.",
    "keywords": [
        "Kyrch",
        "laravel",
        "laravel-prohibitions"
    ],
    "homepage": "https://github.com/kyrch/laravel-prohibitions",
    "license": "MIT",
    "authors": [
        {
            "name": "Kyrch",
            "email": "kyrchk5@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.92.7",
        "illuminate/contracts": "^12.0||^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.1.12",
        "larastan/larastan": "^3.9.3",
        "laravel/pint": "^1.29",
        "mrpunyapal/rector-pest": "^0.2.3",
        "nunomaduro/collision": "^8.9.1",
        "orchestra/testbench": "^11.0.0||^10.8.0",
        "pestphp/pest": "^4.4.2",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "rector/rector": "^2.3.9"
    },
    "autoload": {
        "psr-4": {
            "Kyrch\\Prohibition\\": "src/",
            "Kyrch\\Prohibition\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kyrch\\Prohibition\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "setup": [
            "composer install"
        ],
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "post-update-cmd": [
            "composer bump --dev-only"
        ],
        "lint": [
            "rector",
            "pint"
        ],
        "test:lint": [
            "rector --dry-run",
            "pint --test"
        ],
        "test:types": "./vendor/bin/phpstan analyse --memory-limit=-1",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kyrch\\Prohibition\\ProhibitionServiceProvider"
            ],
            "aliases": {
                "Prohibition": "Kyrch\\Prohibition\\Facades\\Prohibition"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
